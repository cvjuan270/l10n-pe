<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_move_form_voucher" model="ir.ui.view">
        <field name="name">account.move.form.voucher</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='line_ids']/list/field[@name='account_id']"
                position="after"
            >
                <field name="l10n_pe_voucher_id" optional="hide" readonly="1" />
            </xpath>
        </field>
    </record>
</odoo>
