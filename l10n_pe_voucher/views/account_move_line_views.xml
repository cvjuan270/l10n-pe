<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Standalone Journal Items list -->
    <record id="view_move_line_tree_voucher" model="ir.ui.view">
        <field name="name">account.move.line.list.voucher</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree" />
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="l10n_pe_voucher_id" optional="show" />
            </field>
        </field>
    </record>

    <!-- Journal Items search: filter and group by voucher -->
    <record id="view_account_move_line_filter_voucher" model="ir.ui.view">
        <field name="name">account.move.line.search.voucher</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter" />
        <field name="arch" type="xml">
            <field name="move_id" position="after">
                <field name="l10n_pe_voucher_id" />
            </field>
            <filter name="group_by_account" position="after">
                <filter
                    name="group_by_l10n_pe_voucher"
                    string="Voucher"
                    context="{'group_by': 'l10n_pe_voucher_id'}"
                />
            </filter>
        </field>
    </record>
</odoo>
