<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sire_rvie_replacement_wizard_form" model="ir.ui.view">
        <field name="name">sire.rvie.replacement.wizard.form</field>
        <field name="model">sire.rvie.replacement.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="periodo_id" invisible="1" />
                    <field
                        name="company_id"
                        groups="base.group_multi_company"
                        readonly="1"
                    />
                    <field name="attachment_filename" invisible="1" />
                    <field name="attachment" filename="attachment_filename" />
                </group>
                <footer>
                    <button
                        name="action_upload"
                        type="object"
                        string="Subir reemplazo"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
