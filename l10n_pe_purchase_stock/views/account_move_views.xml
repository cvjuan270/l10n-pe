<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_stock_price_adjustment" model="ir.ui.view">
        <field name="name">account.move.form.stock.price.adjustment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Only meaningful on vendor credit notes -->
            <field name="invoice_date" position="after">
                <field name="stock_price_adjustment"
                       invisible="move_type != 'in_refund'"/>
            </field>
        </field>
    </record>
</odoo>
