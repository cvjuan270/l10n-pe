<odoo>

    <record id="l10n_pe_vat_view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.l10n.pe.vat</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_latam_base.view_partner_latam_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_latam_identification_type_id']/following-sibling::field[@name='vat']"
                   position="attributes">
                <attribute name="widget">l10n_pe_vat_consult</attribute>
            </xpath>
        </field>
    </record>

</odoo>
