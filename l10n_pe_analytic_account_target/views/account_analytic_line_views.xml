<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- View account.analytic.line form -->
    <record id="view_account_analytic_line_form" model="ir.ui.view">
        <field name="name">view.account.analytic.line.form</field>
        <field name="model">account.analytic.line</field>
        <field
            name="inherit_id"
            ref="account.view_account_analytic_line_form_inherit_account"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting']" position="inside">
                <field name="category" invisible="1" />
                <button
                    name="action_create_destination_move"
                    string="Crear asiento de destino"
                    type="object"
                    class="oe_highlight"
                    invisible="account_target_id or category not in ('vendor_bill', 'other')"
                />
                <field
                    name="account_target_id"
                    invisible="category not in ('vendor_bill', 'other')"
                />
            </xpath>
        </field>
    </record>

    <!-- View account.analytic.line tree -->
    <record id="view_account_analytic_line_tree" model="ir.ui.view">
        <field name="name">view.account.analytic.line.tree</field>
        <field name="model">account.analytic.line</field>
        <field
            name="inherit_id"
            ref="account.view_account_analytic_line_tree_inherit_account"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field
                    name="account_target_id"
                    column_invisible="True"
                    optional="show"
                />
            </xpath>
        </field>
    </record>
</odoo>
