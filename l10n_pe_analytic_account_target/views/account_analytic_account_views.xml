<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="analytic_view_account_analytic_account_form" model="ir.ui.view">
        <field name="name">analytic.view_account_analytic_account_form</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main']" position="after">
                <group name="entry_target">
                    <group>
                        <field name="account_entry_target" />
                        <field
                            name="acccount_debit_target"
                            required="account_entry_target"
                            invisible="not account_entry_target"
                        />
                        <field
                            name="acccount_credit_target"
                            required="account_entry_target"
                            invisible="not account_entry_target"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
