<data>

    <record id="view_account_move_tree" model="ir.ui.view">
        <field name="name">Add entry number to tree view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"></field>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="entry_number" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">Add entry number to form header</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <h5>
                    <field name="entry_number" nolabel="1" attrs="{'invisible':[('move_type','not in',('in_invoice', 'in_refund'))]}"/>
                </h5>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_filter" model="ir.ui.view">
        <field name="name">Agregar número de asiento en la busqueda</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="entry_number"></field>
            </field>
        </field>
    </record>


</data>
